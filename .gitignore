# ==========================================
# dbt (Data Build Tool)
# ==========================================
# Build artifacts & compiled SQL (regenerated on every run)
processing/dbt_pricing/target/
processing/dbt_pricing/logs/
processing/dbt_pricing/dbt_packages/

# Local DuckDB database file (regenerated artifact)
processing/dbt_pricing/dbt.duckdb
processing/dbt_pricing/*.duckdb

# Local parquet/data files downloaded for testing (data artifacts)
processing/dbt_pricing/*.parquet
processing/dbt_pricing/bronze_orders.parquet

# User-specific machine settings
processing/dbt_pricing/.user.yml

# ==========================================
# Feast (Feature Store)
# ==========================================
# The local SQLite registry
processing/feature_store/data/registry.db
processing/feature_store/data/*.db

# Feast generated Python caches
processing/feature_store/**/__pycache__/

# ==========================================
# Docker & Local Volumes
# ==========================================
# Local data volumes if mounted directly (usually in Docker named volumes, but just in case)
minio_data/
postgres_data/
kafka_data/
zookeeper_data/

# Docker debug artifacts
.docker/

